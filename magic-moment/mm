# still exists (pre-shipped-stack installs left one; install.sh reclaims
# it). The current stack ships with the VM — cell PIL, cell ffmpeg, node +
# bundled playwright — so on an up-to-date VM these loops find nothing.
sys.path.insert(0, SKILL)
# load vendor_path by FILE, not via the cmm package: cmm/__init__ imports
# PIL-dependent modules, and on a python without Pillow (e.g. the VM host)
# that would crash the CLI before this bootstrap can put vendor (which
# carries Pillow) on sys.path.
import importlib.util  # noqa: E402
_spec = importlib.util.spec_from_file_location(
    "_mm_vendor_path", os.path.join(SKILL, "cmm", "vendor_path.py"))
_vendor_path = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_vendor_path)
vendor_dirs = _vendor_path.vendor_dirs
for _v in vendor_dirs():
    if os.path.isdir(_v):
        sys.path.insert(1, _v)
        os.environ["PATH"] = os.path.join(_v, "bin") + ":" + os.environ.get("PATH", "")
os.environ.setdefault("PYTHONWARNINGS", "ignore")
for bad in ("NO_PROXY", "no_proxy"):
    # brackets in these break httpx/urllib in some stacks; nothing here needs them
    os.environ.pop(bad, None)

