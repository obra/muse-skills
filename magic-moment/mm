def _die(msg):
    print(f"ERROR: {msg}", flush=True)
    sys.exit(1)


def _load_screenplay(path):
    try:
        sp = json.load(open(os.path.expanduser(path)))
    except FileNotFoundError:
        _die(f"screenplay not found: {path}")
    except json.JSONDecodeError as e:
        _die(f"screenplay is not valid JSON: {e}")
    if not isinstance(sp, dict):
        _die("screenplay must be a JSON object")
    from cmm.run_contract import run_name
    run_name(sp.get("name"))
    for req in ("name", "video", "beats"):
        if not sp.get(req):
            _die(f"screenplay needs a '{req}' field (see ./mm example)")
    if not isinstance(sp["video"], str):
        _die("video must be a path string")
    sp["video"] = os.path.expanduser(sp["video"])
    if not os.path.exists(sp["video"]):
        _die(f"creator video not found: {sp['video']}")
    return sp


