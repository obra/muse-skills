{
  "name": "@hatch/base-ui",
  "version": "0.1.0",
  "description": "The public parts of Base UI 1.9.0, bundled with React external, for TypeScript Spaces that install it from the bundle.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@types/react": "19.2.14"
  }
}
